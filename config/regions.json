{
  "$comment": "Harmonized regions. Within a group, regions are assigned in list order: each region is its bbox MINUS the bboxes in `exclude`, so the group tiles without overlap and group totals are exact sums. California keeps its original bbox (it also covers western Nevada).",
  "regions": [
    { "id": "california",        "group": "us", "name": "California (and W. Nevada)",          "bbox": [-124.5, 32.5, -114.0, 42.1], "exclude": [] },
    { "id": "pacific_northwest", "group": "us", "name": "Pacific Northwest (WA, OR, ID)",       "bbox": [-125.0, 42.1, -111.0, 49.5], "exclude": ["california"] },
    { "id": "southwest",         "group": "us", "name": "Southwest (AZ, NM, S. NV/UT)",         "bbox": [-120.0, 24.0, -103.0, 37.0], "exclude": ["california", "pacific_northwest"] },
    { "id": "interior_west",     "group": "us", "name": "Interior West (NV, UT, CO, WY, MT)",   "bbox": [-120.0, 37.0, -102.0, 49.5], "exclude": ["california", "pacific_northwest", "southwest"] },
    { "id": "great_plains",      "group": "us", "name": "Great Plains (Dakotas to Texas)",      "bbox": [-104.0, 25.5, -94.0, 49.5],  "exclude": ["california", "pacific_northwest", "southwest", "interior_west"] },
    { "id": "southeast",         "group": "us", "name": "Southeast",                            "bbox": [-94.0, 24.0, -75.0, 37.0],   "exclude": ["california", "pacific_northwest", "southwest", "interior_west", "great_plains"] },
    { "id": "midwest_northeast", "group": "us", "name": "Midwest and Northeast",                "bbox": [-97.5, 37.0, -66.5, 49.5],   "exclude": ["california", "pacific_northwest", "southwest", "interior_west", "great_plains", "southeast"] },
    { "id": "alaska",            "group": "us", "name": "Alaska",                               "bbox": [-180.0, 51.0, -129.0, 71.5], "exclude": [] },
    { "id": "hawaii",            "group": "us", "name": "Hawaii",                               "bbox": [-161.0, 18.5, -154.5, 22.5], "exclude": [] }
  ],
