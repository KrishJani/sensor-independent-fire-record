# Production endpoints. Public URLs only: never put secrets here, every VITE_ variable ends up in the
# browser bundle. One api-worker serves the chat copilot and the archival API, so VITE_API_BASE is not
# needed. VITE_MAPBOX_TOKEN: .env.production.local (gitignored) or the shell.
VITE_REALTIME_URL=https://nasa-fire-realtime.krishjani01.workers.dev
VITE_API_URL=https://nasa-fire-api.krishjani01.workers.dev
