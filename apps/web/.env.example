VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token

# Realtime tab (apps/realtime-worker) and chat copilot (apps/api-worker)
VITE_REALTIME_URL=http://localhost:8789
VITE_API_URL=http://localhost:8787
# Replay controls (pause/resume/stop/speed) are for presenters only: open the app once with
# ?key=<REPLAY_TOKEN>. The token is never a build variable, so it never ships in the bundle.
