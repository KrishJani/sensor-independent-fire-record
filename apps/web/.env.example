VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token

# Realtime tab (apps/realtime-worker) and chat copilot (apps/api-worker)
VITE_REALTIME_URL=http://localhost:8789
VITE_API_URL=http://localhost:8787
# Replay controls (start, pause, resume, stop, speed) are open to every visitor. The worker allows one
# replay at a time and one new replay per 30 s.

# Archival tab (Fire Explorer, calendar, prone areas): the api-worker's archive deployment. Optional in
# local dev (Vite proxies /api to :8787); falls back to VITE_API_URL when unset.
# VITE_API_BASE=
