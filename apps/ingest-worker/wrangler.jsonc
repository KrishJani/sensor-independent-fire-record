{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nasa-fire-ingest",
  // Cloudflare account that owns the shared D1 / KV / Hyperdrive (avoids the multi-account prompt)
  "account_id": "7d56e968fb40e19867fb8043a90f2f4e",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // ONE cron (SPEC §2). Every 3 h: NRT → D1, always. The 24 h SP job (→ Postgres) and the
    // 92-day D1 → Postgres handover run on the same tick, gated by the KV key
    // ingest:sp:last_success_at, so jobs never overlap and a missed daily run catches up.
    "crons": ["0 */3 * * *"]
  },
  "vars": {
    "SP_INTERVAL_HOURS": "24",
    "NRT_DAY_RANGE": "2",
    // Rolling realtime window. D1 keeps exactly the last 92 days; older dates are handed
    // over to Postgres (SP if published, else provisional NRT that SP later replaces).
    "D1_RETENTION_DAYS": "92",
    "FIRMS_MAX_TX_PER_RUN": "1500"
  },
  "d1_databases": [
    {
      "binding": "NRT_DB",
      "database_name": "firms-nrt-cells",
      // Shared with api-worker. Created with: npx wrangler d1 create firms-nrt-cells
      "database_id": "42f0df01-e8a9-408c-acdf-b7af2ee19a5b",
      "migrations_dir": "../../packages/db/d1"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0ff8af0e49994b6b932f34caf78ece73"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "INGEST_STATE",
      // Namespace title "FIRMS_INGEST_STATE" (the binding name stays INGEST_STATE). Same id in api-worker (read-only there). Created with:
      //   npx wrangler kv namespace create FIRMS_INGEST_STATE
      "id": "fbd5a9bf8e124c81b0df1595b5a07566"
    }
  ]
  // secret: FIRMS_MAP_KEY  →  npx wrangler secret put FIRMS_MAP_KEY   (local: apps/ingest-worker/.dev.vars)
}
