{
  // One deployment serves the chat copilot and the archival API. No account_id: wrangler uses the
  // logged-in account, or CLOUDFLARE_ACCOUNT_ID when set.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nasa-fire-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "AI_GATEWAY_ID": "nasa-fire-copilot",
    // Chat copilot (see CHAT.md). CHAT_MODEL is a Workers AI id (@cf/...) or an
    // AI Gateway catalog id (<author>/<model>).
    "CHAT_MODEL": "anthropic/claude-haiku-5.5",
    // Tried when CHAT_MODEL fails before producing output (Workers AI retired kimi-k2.6 on
    // 2026-11-20, HTTP 410). "" disables it. See CHAT.md.
    "CHAT_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Chat reasoning: "none" = off (sent as reasoning_effort null: honoured by the glm fallback,
    // dropped for Claude Haiku, which does not reason unless asked). "" = model default. See CHAT.md.
    "CHAT_REASONING_EFFORT": "none",
    // AI Gateway response cache TTL (s) for chat model calls. "0" = off (default).
    "CHAT_CACHE_TTL": "0",
    // "tavily" (needs the TAVILY_API_KEY secret) or "cloudflare" (Web Search API, billed via AI Gateway).
    "WEB_SEARCH_PROVIDER": "tavily",
    // "mock" until LiveFireData (Hyperdrive + D1) lands. See src/data/fireData.ts.
    "FIRE_DATA_SOURCE": "mock",
    // CORS + agent WebSocket origins. Exact origins, plus "https://*.<suffix>" for exactly one
    // subdomain label (Pages preview URLs). See src/origins.ts.
    "ALLOWED_ORIGINS": "http://localhost:5173,https://world-fires.pages.dev,https://*.world-fires.pages.dev",
    // Archival harmonizer settings.
    "CALIBRATION_START_YEAR": "2013",
    "CALIBRATION_END_YEAR": "2021",
    "BASELINE_START_YEAR": "2001",
    "BASELINE_END_YEAR": "2025",
    "D1_RETENTION_DAYS": "92"
  },
  "d1_databases": [
    // Shared with ingest-worker (read-only here).
    { "binding": "NRT_DB", "database_name": "firms-nrt-cells", "database_id": "c8180d94-c37d-44d1-bd36-350979b47633" }
  ],
  "hyperdrive": [
    // "firms-pg" → archival Postgres; shared with ingest-worker. Origin limit 15 (packages/db/README.md).
    // Created with: npx wrangler hyperdrive create firms-pg --connection-string="<POSTGRES_URL>"
    // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (the dev scripts set it from ../../.env DATABASE_URL).
    { "binding": "HYPERDRIVE", "id": "e56c5b88b27541fbb876c5da8acc377b" }
  ],
  "kv_namespaces": [
    // Namespace title "FIRMS_INGEST_STATE": data versions, ingest flags (ingest:*). realtime-worker
    // shares it under realtime:poll:*. Created with: npx wrangler kv namespace create FIRMS_INGEST_STATE
    { "binding": "INGEST_STATE", "id": "50c1f81afca340b0b98915472b609b01" }
  ],
  "ai": {
    "binding": "AI",
    // No local implementation: under `wrangler dev` this runs against the logged-in account.
    "remote": true
  },
  "services": [
    // apps/realtime-worker: live/replay fire incidents for the get_live_incidents chat tool.
    { "binding": "REALTIME", "service": "nasa-fire-realtime" }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Binding name MUST equal the class name for routeAgentRequest()
        // (/agents/fire-copilot-agent/<sessionId>).
        "name": "FireCopilotAgent",
        "class_name": "FireCopilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FireCopilotAgent"]
    }
  ]
}
