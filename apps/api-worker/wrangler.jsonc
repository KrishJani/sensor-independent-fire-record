{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nasa-fire-api",
  // Cloudflare account that owns the shared D1 / KV / Hyperdrive (avoids the multi-account prompt)
  "account_id": "7d56e968fb40e19867fb8043a90f2f4e",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "AI_GATEWAY_ID": "nasa-fire-copilot",
    "CALIBRATION_START_YEAR": "2013",
    "CALIBRATION_END_YEAR": "2021",
    "BASELINE_START_YEAR": "2001",
    "BASELINE_END_YEAR": "2025",
    "D1_RETENTION_DAYS": "92",
    // Comma-separated browser origins allowed by CORS: local dev + the Cloudflare Pages site
    "ALLOWED_ORIGINS": "http://localhost:5173,https://skywalkers77-fire.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "NRT_DB",
      "database_name": "firms-nrt-cells",
      // Shared with ingest-worker (read-only here)
      "database_id": "42f0df01-e8a9-408c-acdf-b7af2ee19a5b"
    }
  ],
  "hyperdrive": [
    {
      // "firms-pg" → PlanetScale Postgres (archival tier); shared with ingest-worker
      "binding": "HYPERDRIVE",
      "id": "0ff8af0e49994b6b932f34caf78ece73"
    }
  ],
  "kv_namespaces": [
    {
      // Namespace title "FIRMS_INGEST_STATE"; read-only here (data versions, SP high-water marks)
      "binding": "INGEST_STATE",
      "id": "fbd5a9bf8e124c81b0df1595b5a07566"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRE_COPILOT",
        "class_name": "FireCopilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FireCopilotAgent"]
    }
  ]
}
