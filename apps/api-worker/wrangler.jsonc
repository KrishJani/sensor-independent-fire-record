{
  "account_id": "7d56e968fb40e19867fb8043a90f2f4e",
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nasa-fire-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "AI_GATEWAY_ID": "default",
    // Chat copilot (see CHAT.md). CHAT_MODEL is a Workers AI id (@cf/...) or an
    // AI Gateway catalog id (<author>/<model>).
    "CHAT_MODEL": "@cf/moonshotai/kimi-k2.6",
    // Tried when CHAT_MODEL fails before producing output.
    "CHAT_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
    // "tavily" (needs the TAVILY_API_KEY secret) or "cloudflare" (Web Search API, billed via AI Gateway).
    "WEB_SEARCH_PROVIDER": "tavily",
    // "mock" until LiveFireData (Hyperdrive + D1) lands. See src/data/fireData.ts.
    "FIRE_DATA_SOURCE": "mock",
    // Comma-separated list of origins allowed by CORS.
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "CALIBRATION_START_YEAR": "2012",
    "CALIBRATION_END_YEAR": "2025"
  },
  "d1_databases": [
    {
      "binding": "NRT_DB",
      "database_name": "firms-nrt-cells"
      // Omit database_id on first deploy: `wrangler deploy` will auto-create D1
      // and write the generated UUID here. Copy that UUID to ingest-worker afterward.
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>"
    }
  ],
  "ai": {
    "binding": "AI",
    // No local implementation: under `wrangler dev` this runs against the logged-in account.
    "remote": true
  },
  "services": [
    // apps/realtime-worker: live/replay fire incidents for the get_live_incidents chat tool.
    { "binding": "REALTIME", "service": "nasa-fire-realtime" }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Binding name MUST equal the class name for routeAgentRequest()
        // (/agents/fire-copilot-agent/<sessionId>).
        "name": "FireCopilotAgent",
        "class_name": "FireCopilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FireCopilotAgent"]
    }
  ]
}
