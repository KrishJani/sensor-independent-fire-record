{
  "name": "api-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$(grep ^DATABASE_URL= ../../.env | cut -d= -f2-)\"; wrangler dev --port 8787 --persist-to ../../.wrangler/shared-state'",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/harmonizer": "workspace:*",
    "hono": "^4.7.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0"
  }
}
