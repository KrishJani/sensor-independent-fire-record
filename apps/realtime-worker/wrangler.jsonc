{
  "account_id": "7d56e968fb40e19867fb8043a90f2f4e",
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nasa-fire-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Comma-separated list of origins allowed by CORS (same approach as api-worker).
    "ALLOWED_ORIGINS": "http://localhost:5173",
    // Default replay speed: stream seconds per real second (see REALTIME.md).
    "REPLAY_DEFAULT_SPEED": "12000",
    // Live polling areas, ";"-separated w,s,e,n boxes. Default: North America.
    "WATCH_BBOXES": "-170,15,-50,72",
    // Enrichment briefs: same gateway and models as api-worker (see apps/api-worker/CHAT.md).
    "AI_GATEWAY_ID": "default",
    "CHAT_MODEL": "@cf/moonshotai/kimi-k2.6",
    "CHAT_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
    // "" disables the fallback (see apps/api-worker/CHAT.md). Brief settings below are measured in REALTIME.md.
    // Max enrichment workflows (and so AI briefs) per stream: per rolling 24 h for "live", per replay otherwise.
    "ENRICH_MAX_PER_STREAM": "30",
    // Global cap on AI briefs across all streams, per rolling 24 h (re-briefs count).
    "BRIEF_DAILY_MAX": "60",
    // Replays only brief incidents whose affected area reaches this (Quebec: 21 incidents end above 200 km²).
    "BRIEF_MIN_AREA_KM2": "200",
    // kimi-k2.6 supports "high" | "none" ("low" is mapped to "high"). "none": ~2 s per brief instead of ~55 s.
    "BRIEF_REASONING_EFFORT": "none",
    "BRIEF_MAX_TOKENS": "120"
  },
  "ai": {
    "binding": "AI",
    // No local implementation: under `wrangler dev` this runs against the logged-in account.
    "remote": true
  },
  "workflows": [
    {
      "name": "nasa-fire-incident-enrich",
      "binding": "INCIDENT_ENRICH",
      "class_name": "IncidentEnrichWorkflow"
    }
  ],
  "services": [
    // api-worker, for the historical calendar in enrichment. Optional: skipped when unavailable.
    { "binding": "API", "service": "nasa-fire-api" }
  ],
  // Live polling: FIRMS NRT every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "kv_namespaces": [
    {
      // Per-source poll state (keys realtime:poll:<source>:<bbox>). Omit id on first deploy to auto-provision,
      // or paste the shared INGEST_STATE id from the ingest-worker once it has one.
      "binding": "INGEST_STATE"
    }
  ],
  "queues": {
    "producers": [{ "binding": "DETECTIONS_QUEUE", "queue": "nasa-fire-detections" }],
    "consumers": [
      {
        "queue": "nasa-fire-detections",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "r2_buckets": [
    {
      // Replay scenarios (scenarios/<id>.json) and the raw NRT CSV archive (raw/nrt/...).
      "binding": "REPLAY_DATA",
      "bucket_name": "nasa-fire-realtime"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CLUSTERER", "class_name": "Clusterer" },
      { "name": "INCIDENT", "class_name": "Incident" },
      { "name": "LIVE_HUB", "class_name": "LiveHub" },
      { "name": "REPLAY", "class_name": "Replay" },
      // Global singleton: one-active-replay slot and the daily brief budget.
      { "name": "CONTROL", "class_name": "Control" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Clusterer", "Incident", "LiveHub", "Replay"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Control"]
    }
  ],
  "observability": { "enabled": true }
}
